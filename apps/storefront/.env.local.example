# Savia Organics — Storefront environment variables
# Rename this file to .env.local for local development

# Medusa backend URL — local dev
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000

# Medusa backend URL — production (Easypanel)
# NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://medusa-admin.i8knmp.easypanel.host

# Publishable API key — get it from Medusa Admin > Settings > API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Base URL of the storefront (used for og:url and sitemaps)
NEXT_PUBLIC_BASE_URL=http://localhost:8000
# NEXT_PUBLIC_BASE_URL=https://saviaorganic.com

# Optional: Stripe publishable key (when you set up payments)
# NEXT_PUBLIC_STRIPE_KEY=pk_live_...

# Optional: Algolia search (not required — native search works without it)
# NEXT_PUBLIC_SEARCH_APP_ID=
# NEXT_PUBLIC_SEARCH_API_KEY=
# NEXT_PUBLIC_SEARCH_INDEX_NAME=products
